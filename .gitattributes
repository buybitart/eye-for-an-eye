# Normalise line endings so Linux, macOS and Windows produce the same diff.
* text=auto eol=lf

*.sh          text eol=lf
*.py          text eol=lf
*.toml        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.service     text eol=lf
*.bat         text eol=crlf

# Binary files must not be converted.
*.onnx        binary
*.pdf         binary
*.pcap        binary
*.pcapng      binary
*.whl         binary
*.gz          binary
*.mmdb        binary

# Generated evidence is collapsed in pull request diffs.
uv.lock                  linguist-generated=true
datasets/manifests/*     linguist-generated=true
models/*-evaluation.json linguist-generated=true
